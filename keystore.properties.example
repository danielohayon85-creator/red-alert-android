# Copy this file to keystore.properties (git-ignored — never commit real values) and fill it in
# with your own release keystore's details. See README.md "יצירת keystore וחתימת release" for
# the full walkthrough, including the `keytool` command to generate the keystore itself.
#
# storeFile can be relative to the project root or an absolute path — keeping the actual .jks
# OUTSIDE this repo entirely (e.g. in a password manager / secure backup) is strongly recommended;
# losing it permanently breaks the ability to publish updates to an app already on Play Store.

storeFile=/absolute/path/to/your/azakon-release.jks
storePassword=CHANGE_ME
keyAlias=azakon
keyPassword=CHANGE_ME
