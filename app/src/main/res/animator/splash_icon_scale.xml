<?xml version="1.0" encoding="utf-8"?>
<!-- Splash icon "pop-in": scales up from 40% with a slight overshoot bounce while fading in,
     instead of just appearing statically. Total 450ms, matches
     windowSplashScreenAnimationDuration in themes.xml. -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator
        android:propertyName="scaleX"
        android:valueFrom="0.4"
        android:valueTo="1.0"
        android:duration="450"
        android:interpolator="@android:interpolator/overshoot" />
    <objectAnimator
        android:propertyName="scaleY"
        android:valueFrom="0.4"
        android:valueTo="1.0"
        android:duration="450"
        android:interpolator="@android:interpolator/overshoot" />
    <objectAnimator
        android:propertyName="alpha"
        android:valueFrom="0"
        android:valueTo="1"
        android:duration="250" />
</set>
